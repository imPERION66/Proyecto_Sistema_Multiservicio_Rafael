# ==========================================
# Root .gitignore for Proyecto Multiservicio
# ==========================================

# Compiled & Build Output
dist/
**/dist/
tmp/
out-tsc/
bazel-out/

# Node & Frontend
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular cache
.angular/
**/.angular/

# Maven & Java build
target/
**/target/
*.class
*.jar
*.war
*.ear

# IDEs and Editors
.idea/
*.iml
.project
.classpath
.settings/
.vscode/
*.sublime-workspace
.history/

# Environment Variables & Secrets
.env
.env.*
.env.local
!.env.example

# OS Generated
.DS_Store
Thumbs.db
